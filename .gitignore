# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files (overridden in CI/CD secrets)
*.tfvars
!*.auto.tfvars
!example.tfvars
!terraform.tfvars.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Sensitive keys and secrets
*.pem
*.key
*.pfx

# System files
.DS_Store
Thumbs.db
